# Flask Secret Key
SECRET_KEY=change_this_to_a_secure_random_key

# PostgreSQL Database (Auto-provided by Render Blueprint or self-hosted)
DATABASE_URL=postgresql://user:password@hostname:5432/study_db

# Cloudinary Storage Configuration (For student avatars & materials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (For sending Password Reset emails to registered student address)
# If using Gmail: Enable 2-Factor Auth and create an App Password (16 characters)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER_NAME=StudyAI Academic Support

# Development Settings
FLASK_DEBUG=false
PORT=5000
